{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finguard.io/contracts/audit/security-auth-event.schema.json",
  "title": "SecurityAuthEvent",
  "description": "Business Audit과 분리하여 저장하는 최소 인증 실패 이벤트",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "securityEventId",
    "requestId",
    "eventType",
    "reasonCode",
    "credentialType",
    "occurredAt"
  ],
  "properties": {
    "securityEventId": { "$ref": "#/$defs/nonEmptyIdentifier" },
    "requestId": { "$ref": "#/$defs/nonEmptyIdentifier" },
    "traceId": { "$ref": "#/$defs/nonEmptyIdentifier" },
    "eventType": { "const": "AUTH_FAILURE" },
    "reasonCode": { "const": "AGENT_AUTHENTICATION_FAILED" },
    "credentialType": { "const": "AGENT_SERVICE" },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "occurredAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "nonEmptyIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
