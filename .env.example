POSTGRES_DB=finguard
POSTGRES_USER=finguard
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
OPA_PORT=8181

# Never commit real credentials.
#
# 값을 비워 둔다. 기동 시 검증이 "비어 있음"은 막지만 "모두가 아는 값"은 막지 못하므로,
# change-me 같은 예시 값을 두면 그게 그대로 운영에 남는다.
# 각자 생성해서 채운다:
#   openssl rand -base64 32
#   pwsh:  [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
AGENT_SERVICE_CREDENTIAL=
FINGUARD_INTERNAL_CREDENTIAL=

# P0 Core API opaque Bearer credentials — docs/04-api-contract.md §2.
# Vue 소스·빌드 산출물·Web Storage에 넣지 않는다. 실행 시 메모리로만 전달한다.
# 두 값이 같으면 Core가 기동하지 않는다.
VIEWER_CREDENTIAL=
OPERATOR_CREDENTIAL=
# OPERATOR_CREDENTIAL에 결합되는 단일 Employee. 비어 있으면 Core가 기동하지 않는다.
OPERATOR_EMPLOYEE_ID=EMP-101

GATEWAY_BASE_URL=http://localhost:8091
GATEWAY_TIMEOUT=10s

PROMPT_BLOCK_THRESHOLD=0.90
HARD_REQUEST_LIMIT_1M=30

# ai-risk 는 /ready 요청에서 모델을 적재하며 기본 한도 1g 를 넘긴다. 넘기면 느려지는
# 것이 아니라 OOM 으로 죽고, 컨테이너가 무한 재시작한다(EC2 배포에서 122회 관측).
# 호스트 메모리가 허락하면 2g 를 준다.
AI_RISK_MEM_LIMIT=2g
