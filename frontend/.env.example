# mock: local fixtures, real: Spring Core API
VITE_FINBOUND_API_MODE=mock

# Public API origin only. Never put VIEWER_CREDENTIAL or OPERATOR_CREDENTIAL here.
VITE_FINBOUND_API_BASE_URL=/core-api

# Vite development proxy only. Production must provide the same reverse-proxy route.
VITE_FINBOUND_DEV_PROXY_TARGET=http://localhost:8080
